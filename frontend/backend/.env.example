# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env — ele já está no .gitignore.

# Supabase → Project Settings → Database
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"

# Opcional em produção: origem permitida para CORS
FRONTEND_ORIGIN="https://seu-dominio.vercel.app"

PORT=3001

# JWT Secret para autenticação — gere um valor aleatório longo, ex:
# openssl rand -hex 32
JWT_SECRET="troque-por-um-valor-aleatorio-longo"
