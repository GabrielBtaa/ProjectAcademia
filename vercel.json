{
  "framework": null,
  "builds": [
    {
      "src": "backend/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/dist/assets/$1"
    },
    {
      "src": "/(.*)\.js",
      "dest": "/frontend/dist/$1.js"
    },
    {
      "src": "/(.*)\.css",
      "dest": "/frontend/dist/$1.css"
    },
    {
      "src": "/favicon\.ico",
      "dest": "/frontend/dist/favicon.ico"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/index.html"
    }
  ],
  "installCommand": "cd backend && npm install && npx prisma generate",
  "buildCommand": "cd frontend && npm install && npm run build"
}
