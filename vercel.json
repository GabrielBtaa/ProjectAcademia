{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/dist/assets/$1"
    },
    {
      "src": "/(.*\\.(?:js|css|map|ico|svg|json))",
      "dest": "/frontend/dist/$1"
    },
    {
      "src": "/.*",
      "dest": "/frontend/dist/index.html"
    }
  ],
  "installCommand": "cd backend && npm install && npx prisma generate",
  "buildCommand": "cd frontend && npm install && npm run build",
  "publicPath": "frontend/dist"
}
