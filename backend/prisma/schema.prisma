generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  usuario
}

enum StatusAluno {
  ativo
  inadimplente
  inativo
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
  nome     String
  role     UserRole @default(usuario)
}

model Plano {
  id        Int     @id @default(autoincrement())
  nome      String
  duracao   Int
  valor     Decimal @db.Decimal(10, 2)
  descricao String?
  alunos    Aluno[]
}

enum StatusPagamento {
  pendente
  confirmado
  cancelado
}

model Pagamento {
  id         Int             @id @default(autoincrement())
  valor      Decimal         @db.Decimal(10, 2)
  data       DateTime        @db.Date
  status     StatusPagamento @default(pendente)
  metodo     String          @default("PIX")
  alunoId    Int
  aluno      Aluno           @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Aluno {
  id             Int         @id @default(autoincrement())
  nome           String
  cpf            String      @unique
  whatsapp       String
  dataNascimento DateTime    @db.Date
  dataVencimento DateTime    @db.Date
  status         StatusAluno @default(ativo)
  avatar         String?
  dataCadastro   DateTime    @default(now())
  planoId        Int
  plano          Plano       @relation(fields: [planoId], references: [id], onDelete: Restrict)
  pagamentos     Pagamento[]
}
